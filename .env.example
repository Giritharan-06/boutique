# Server-only PostgreSQL connection. Put the real value in .env.local.
# Leave unset to use the offline SQLite database.
DATABASE_URL=

# Optional canonical HTTPS origin for a custom domain. Vercel domains are
# otherwise trusted from VERCEL_URL and VERCEL_PROJECT_PRODUCTION_URL.
APP_ORIGIN=

# Experimental browser-only fabric prototype. Off unless explicitly enabled.
# Access also requires the existing admin session; this is not a customer flag.
FABRIC_TRIAL_ENABLED=false

# Optional password-reset email delivery; set these server-side when ready.
RESEND_API_KEY=
PASSWORD_RESET_FROM=
# Canonical site origin, e.g. https://your-boutique.vercel.app (no path).
PASSWORD_RESET_ORIGIN=

# Admin-only AI Fashion Studio. Nothing is public; every API also checks admin auth.
AI_FASHION_STUDIO_ENABLED=false
# Explicit, unreliable public-demo testing. Never treat demos as production inference.
AI_STUDIO_ALLOW_DEMOS=false
AI_STUDIO_DAILY_LIMIT=8
# 32 random bytes encoded as 64 hex characters. Required for hosted encrypted uploads.
AI_STUDIO_IMAGE_KEY=
# Optional scoped server-only Hugging Face token. Never NEXT_PUBLIC_.
HF_TOKEN=
# Optional reviewed asynchronous gateway (contract in docs/AI_FASHION_STUDIO.md).
AI_STUDIO_GATEWAY_URL=
AI_STUDIO_GATEWAY_APPROVED=false
AI_STUDIO_SAREE_REVIEWED=false
# Used by the authenticated scheduled cleanup endpoint.
CRON_SECRET=
